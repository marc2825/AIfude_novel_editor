APP_ORIGIN=http://127.0.0.1:3000
# Supported modes: chatgpt, claude, local, disabled, mock,
# openai, anthropic, gemini, xai, deepseek.
# Without an explicit AI_PROVIDER environment setting, AI remains disabled.
# The AI connection settings screen can override provider/model settings without restart.
# Server-only JSON, default: ~/.local/share/novel-ai-editor/ai-settings.json.
# Optional absolute file outside this repository:
# NOVEL_AI_SETTINGS_PATH=
AI_PROVIDER=mock
# ChatGPT subscription: sign in from Settings. No API key is required.
# The model must be available in the signed-in account's catalog.
CHATGPT_MODEL=gpt-6.1-sol
# Optional absolute directory for server-only credentials; omit to use the default.
# CHATGPT_AUTH_DIR=
# Compare selected providers simultaneously (2-3 per request).
# Remove this setting to hide comparison. Each enabled entry must be configured.
AI_COMPARE_PROVIDERS=
# Claude subscription via the official Claude CLI, installed and logged in separately.
# The app does not force a login method. A non-subscription CLI login (API key etc.)
# is billed to your own account and requires AI_ENABLE_PAID_API=true.
# Use an exact model ID, not an alias such as sonnet or default.
CLAUDE_MODEL=claude-sonnet-5
# Default: ~/.local/share/novel-ai-editor/claude (outside this repository).
# CLAUDE_AUTH_DIR=
# Optional absolute path to the official CLI; default: claude on PATH.
# CLAUDE_CLI_PATH=
# Ollama: http://127.0.0.1:11434/v1
# LM Studio: http://127.0.0.1:1234/v1
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Set the exact identifier of a locally loaded JSON Schema-capable model.
LOCAL_LLM_MODEL=
# Optional: only if your local server requires authentication.
LOCAL_LLM_API_KEY=
# Paid APIs are OFF by default. To use them, set true here AND enable
# API connections in the app settings for the current page session.
AI_ENABLE_PAID_API=false
# Add desired API provider IDs to AI_COMPARE_PROVIDERS explicitly.
# API keys and exact supported model IDs remain server-side.
OPENAI_API_KEY=
# Supported values are documented in README.md.
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
